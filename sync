#!/usr/bin/env bash

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
XDG_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
INSTALL_PLATFORM=false
FORCE=false

usage() {
	cat <<'EOF'
Usage: ./sync [--with-platform] [--force]

  --with-platform  Install the small set of managed shell dependencies.
  --force          Replace conflicting files instead of stopping safely.
  -h, --help       Show this help.
EOF
}

die() {
	printf 'error: %s\n' "$1" >&2
	exit 1
}

warn() {
	printf 'warning: %s\n' "$1" >&2
}

detect_os() {
	if [[ "${OSTYPE:-}" == darwin* ]]; then
		printf 'macos\n'
	elif [[ -r /etc/os-release ]]; then
		# shellcheck disable=SC1091
		. /etc/os-release
		printf '%s\n' "${ID:-linux}"
	else
		printf 'unknown\n'
	fi
}

for arg in "$@"; do
	case "$arg" in
		--with-platform) INSTALL_PLATFORM=true ;;
		--force) FORCE=true ;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			usage >&2
			die "unknown option: $arg"
			;;
	esac
done

OS="$(detect_os)"
printf 'Detected OS: %s\n' "$OS"
printf 'Dotfiles: %s\n' "$DOTFILES_DIR"

install_zsh_plugin() {
	local repo="$1"
	local target="$2"

	[[ -d "$target" ]] && return
	command -v git >/dev/null 2>&1 || die "git is required to install zsh plugins"
	git clone --depth=1 "$repo" "$target"
}

install_platform() {
	if ! command -v cargo >/dev/null 2>&1; then
		command -v curl >/dev/null 2>&1 || die "curl is required to install Rust"
		curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
	fi

	if [[ -r "$HOME/.cargo/env" ]]; then
		# shellcheck disable=SC1091
		. "$HOME/.cargo/env"
	fi

	if ! command -v eza >/dev/null 2>&1; then
		cargo install eza
	fi

	local plugin_dir="$HOME/.zsh-plugins"
	mkdir -p "$plugin_dir"
	install_zsh_plugin https://github.com/zsh-users/zsh-syntax-highlighting.git \
		"$plugin_dir/zsh-syntax-highlighting"
	install_zsh_plugin https://github.com/zsh-users/zsh-completions.git \
		"$plugin_dir/zsh-completions"
	install_zsh_plugin https://github.com/zsh-users/zsh-autosuggestions.git \
		"$plugin_dir/zsh-autosuggestions"
}

link_config() {
	local source="$1"
	local target="$2"

	if [[ ! -e "$source" && ! -L "$source" ]]; then
		warn "skipping missing source: $source"
		return
	fi

	if [[ -L "$target" && "$target" -ef "$source" ]]; then
		printf 'ok      %s\n' "$target"
		return
	fi

	if [[ -e "$target" || -L "$target" ]]; then
		if [[ "$FORCE" != true ]]; then
			die "refusing to replace $target (rerun with --force)"
		fi
		rm -rf "$target"
	fi

	local parent
	parent="$(dirname "$target")"
	if [[ -e "$parent" && ! -d "$parent" ]]; then
		die "cannot create $target because $parent is not a directory"
	fi
	mkdir -p "$parent"
	ln -s "$source" "$target"
	printf 'linked  %s -> %s\n' "$target" "$source"
}

if [[ "$INSTALL_PLATFORM" == true ]]; then
	install_platform
fi

# Shells, terminals, editors, and shared configuration.
link_config "$DOTFILES_DIR/nvim" "$XDG_CONFIG/nvim"
link_config "$DOTFILES_DIR/ghostty" "$XDG_CONFIG/ghostty"
link_config "$DOTFILES_DIR/starship/starship.toml" "$XDG_CONFIG/starship.toml"
link_config "$DOTFILES_DIR/.gitconfig" "$HOME/.gitconfig"
link_config "$DOTFILES_DIR/zsh/.zshrc" "$HOME/.zshrc"
link_config "$DOTFILES_DIR/tmux" "$XDG_CONFIG/tmux"
link_config "$DOTFILES_DIR/kitty" "$XDG_CONFIG/kitty"
link_config "$DOTFILES_DIR/alacritty" "$XDG_CONFIG/alacritty"
link_config "$DOTFILES_DIR/fish" "$XDG_CONFIG/fish"
link_config "$DOTFILES_DIR/ideavimrc/ideavimrc" "$HOME/.ideavimrc"
link_config "$DOTFILES_DIR/herdr/config.toml" "$XDG_CONFIG/herdr/config.toml"
link_config "$DOTFILES_DIR/pi/consent.ts" "$HOME/.pi/agent/extensions/consent.ts"

if [[ "$OS" == macos ]]; then
	APP_SUPPORT="$HOME/Library/Application Support"
	link_config "$DOTFILES_DIR/sublime" "$APP_SUPPORT/Sublime Text/Packages/User"
	for app in Code Cursor Antigravity; do
		link_config "$DOTFILES_DIR/code/settings.json" "$APP_SUPPORT/$app/User/settings.json"
		link_config "$DOTFILES_DIR/code/keybindings.json" "$APP_SUPPORT/$app/User/keybindings.json"
	done
else
	for app in Code Cursor Antigravity; do
		link_config "$DOTFILES_DIR/code/settings.json" "$XDG_CONFIG/$app/User/settings.json"
		link_config "$DOTFILES_DIR/code/keybindings.json" "$XDG_CONFIG/$app/User/keybindings.json"
	done
fi
