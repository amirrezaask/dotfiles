[url "git@gitlab.snappcloud.io:"]
	insteadOf = https://gitlab.snappcloud.io/

[user]
	name = AmirrezaAskarpour
	email = raskarpour@gmail.com

[merge]
	conflictstyle = zdiff3

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	hd = !hunk diff
	hds = !hunk diff --staged

[pull]
	rebase = true

[diff]
	tool = hunk

[difftool "hunk"]
	cmd = hunk diff "$LOCAL" "$REMOTE"
